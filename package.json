{
  "name": "portfolio-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit generate && tsx scripts/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:run": "tsx scripts/migrate.ts",
    "db:seed:force": "tsx src/db/seed.ts --force",
    "smoke": "tsx scripts/smoke.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "portrait": "tsx scripts/portrait.ts",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "perf:lighthouse:mobile": "node scripts/run-lighthouse.mjs mobile",
    "perf:lighthouse:desktop": "node scripts/run-lighthouse.mjs desktop"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@react-three/fiber": "^9.7.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
