# ——— Portfolio-app konfiguratsiyasi ———
# Nusxalang:  cp .env.example .env   va qiymatlarni to'ldiring.

# JWT imzosi MAJBURIY. Generatsiya:  openssl rand -base64 32
AUTH_SECRET=

# Birinchi seed yaratadigan admin hisobi (keyin parolni DB'da almashtiring).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# SQLite fayli (bo'sh bo'lsa ./data/app.db ishlatiladi)
DATABASE_URL=

# Turso/libsql server (ixtiyoriy — bo'sh bo'lsa lokal fayl)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
